{
  "expo": {
    "name": "Platewise",
    "slug": "platewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#14110E",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sampanja.platewise",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Platewise käyttää valitsemaasi kuvaa ruoan tunnistamiseen päiväkirjaan. Kuvaa ei tallenneta.",
          "cameraPermission": "Platewise käyttää kameraa ruoka-annoksen kuvaamiseen päiväkirjaa varten. Kuvaa ei tallenneta.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Platewise käyttää kameraa ruoka-annoksen, viivakoodin ja ravintoarvotaulukon kuvaamiseen päiväkirjaa varten. Kuvia ei tallenneta.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9461A"
        }
      ]
    ],
    "scheme": "platewise",
    "experiments": {
      "typedRoutes": true
    }
  }
}
