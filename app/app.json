{
  "expo": {
    "name": "PlatePal",
    "slug": "platepal",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#14110E",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sampanja.platepal",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlatePal käyttää valitsemaasi kuvaa ruoan tunnistamiseen päiväkirjaan. Kuvaa ei tallenneta.",
          "cameraPermission": "PlatePal käyttää kameraa ruoka-annoksen kuvaamiseen päiväkirjaa varten. Kuvaa ei tallenneta.",
          "microphonePermission": "PlatePal käyttää mikrofonia, kun kirjaat aterian puhumalla. Ääntä ei tallenneta."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PlatePal käyttää kameraa ruoka-annoksen, viivakoodin ja ravintoarvotaulukon kuvaamiseen päiväkirjaa varten. Kuvia ei tallenneta.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9461A"
        }
      ],
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PlatePal käyttää mikrofonia, kun kirjaat aterian puhumalla. Ääntä ei tallenneta.",
          "speechRecognitionPermission": "PlatePal muuttaa puheesi tekstiksi aterian kirjaamista varten. Ääntä ei tallenneta.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "PlatePal",
              "description": "Päivän kalorit ja makrot sekä pikakirjaus kuvalla tai puheella",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "platepal",
    "experiments": {
      "typedRoutes": true
    }
  }
}
